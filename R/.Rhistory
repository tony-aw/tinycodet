?.AtNames()
.AtNames.tinyimport <- function(x, pattern = "") {
# Omdat het object zelf een environment is, kunnen we direct names() opvragen
alle_namen <- names(x)
grep(pattern, alle_namen, value = TRUE)
}
.dpr@across
env_naar_s4 <- function(env, klasse_naam = "DynamischeKlasse") {
# 1. Haal alle elementen en hun types op uit de environment
element_namen <- names(env)
if (length(element_namen) == 0) {
stop("De meegegeven environment is leeg. Kan geen slots definieëren.")
}
# Maak een lijst van slot-types (we gebruiken "ANY" voor maximale flexibiliteit)
slot_lijst <- rep(list("ANY"), length(element_namen))
names(slot_lijst) <- element_namen
# 2. Registreer de S4-klasse dynamisch op runtime
# We checken eerst of de klasse al bestaat om fouten bij herhaling te voorkomen
if (!methods::isClass(klasse_naam)) {
methods::setClass(
Class = klasse_naam,
slots = slot_lijst,
where = topenv() # Zorgt dat de klasse in de package-omgeving leeft
)
}
# 3. Maak het nieuwe S4 object aan
s4_obj <- methods::new(klasse_naam)
# 4. Vul de slots dynamisch met de data uit de environment
for (naam in element_namen) {
methods::slot(s4_obj, naam) <- get(naam, envir = env)
}
return(s4_obj)
}
rm(`@.tinyimport`)
.dpr2 <- env_naar_s4(.dpr)
.dpr2@across
isS4
