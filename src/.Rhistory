code <- "
#include <Rcpp.h>
using namespace Rcpp;
// include after Rcpp.h:
#include <stringi.h>
SEXP rcpp_stri_locate_ith ( SEXP str, String pattern, SEXP opts_regex, int i, SEXP dims ) {
int n = Rf_length(str); // using regular integer, because maximum nrow/ncol for matrix with 2 columns is approx 2^30 -1 anyway
SEXP out = PROTECT(Rf_allocVector(INTSXP, n * 2));
int *pout = INTEGER(out);
int n_matches;
int i2;
SEXP temp;
if(i < 0) {
for(int j = 0; j < n; ++j) {
temp = stri_locate_all_regex(str, pattern, opts_regex);
const int *ptemp = INTEGER_RO(temp);
n_matches = Rf_length(temp) / 2;
i2 = 0;
i2 = n_matches - abs(i + 1);
if(i2 < 1) {
i2 = 1;
}
pout[j] = ptemp[i2 - 1];
pout[j + n] = ptemp[i2 - 1 + n_matches];
}
}
else if(i > 0) {
for(int j = 0; j < n; ++j) {
temp = stri_locate_all_regex(str, pattern, opts_regex);
const int *ptemp = INTEGER_RO(temp);
n_matches = Rf_length(temp) / 2;
i2 = 0;
if(i < n_matches) {
i2 = i;
} else {
i2 = n_matches;
}
pout[j] = ptemp[i2 - 1];
pout[j + n] = ptemp[i2 - 1 + n_matches];
}
}
Rf_setAttrib(out, R_DimSymbol, dims);
UNPROTECT(1);
return  out;
}
"
Rcpp::sourceCpp(code = code)
